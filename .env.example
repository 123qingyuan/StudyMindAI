# StudyMind AI 配置示例；backend/.env 自动读取，切勿覆盖已存在的真实配置。
# 留空时自动生成密钥，保存于 data/.jwt-key。非空必须至少32字符。
STUDYMIND_SECRET=
# 本机安装已使用独立 MySQL 账户。下面仅作格式说明，不是真实凭据。
# DATABASE_URL=mysql+pymysql://USER:PASSWORD@127.0.0.1:3306/studymind?charset=utf8mb4
# 未设置 DATABASE_URL 时使用 SQLite 开发数据库；不得宣称其为 MySQL。
MODEL_PROVIDER=openai-compatible
MODEL_NAME=
API_KEY=
BASE_URL=https://api.openai.com/v1
EMBEDDING_MODE=local
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# 本地模型默认缓存 data/models；本地Qdrant默认 data/qdrant。
# LOCAL_EMBEDDING_CACHE=E:/StudyMindAI/data/models
# 切换到远程Qdrant时设置 URL，API_KEY可选；本地模式仅允许一个API worker。
# QDRANT_URL=http://127.0.0.1:6333
# QDRANT_API_KEY=
# 生产环境不要启用；仅供管理员显式允许受信任的私网模型地址。
AI_ALLOW_PRIVATE_ENDPOINTS=0
